# Environment and secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Composer / Laravel dependencies
vendor/
backend/vendor/

# Laravel generated files
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitkeep
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitkeep

# Node dependencies, if added later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases and exports
*.sqlite
*.sqlite3
*.sql.gz
*.bak
*.backup

# IDE and OS files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.cache
